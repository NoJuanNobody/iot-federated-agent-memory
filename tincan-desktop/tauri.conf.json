{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TinCan Mesh OS",
  "version": "2.2.0",
  "identifier": "com.tincan.mesh.os",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TinCan Mesh OS",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
